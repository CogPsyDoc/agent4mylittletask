# 읽어올 Claude Code 트랜스크립트 폴더 (기본: ~/.claude/projects)
# TRANSCRIPTS_DIR=/Users/you/.claude/projects

# 서버 포트 (기본 4317)
# PORT=4317

# 접속 허용 호스트 (기본 0.0.0.0 = 같은 네트워크 다른 기기에서 접속 가능)
# HOST=0.0.0.0

# 세션 캐시 유효시간(ms)
# CACHE_TTL_MS=5000

# "이어서 대화하기" 활성화 — console.anthropic.com에서 발급
# ANTHROPIC_API_KEY=sk-ant-...

# 이어서 대화에 쓸 모델 (기본 claude-opus-4-8, 저렴하게는 claude-haiku-4-5)
# CLAUDE_MODEL=claude-opus-4-8
