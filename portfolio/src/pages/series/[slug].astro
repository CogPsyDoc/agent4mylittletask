---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import data from '../../data/site.json';

export function getStaticPaths() {
  return data.series.map((s) => ({ params: { slug: s.slug }, props: { series: s } }));
}

const { series } = Astro.props;
---
<Base title={series.name} active="series">
  <a class="back-link" href="/series/">← SERIES</a>
  <div class="detail-head">
    <span class="name">{series.name}</span>
    <span class="meta">{series.year} · {series.tag}</span>
  </div>
  <div class="detail-note">{series.note}</div>
  <div class="photo-grid">
    {series.photos.map((p, i) => (
      <Photo photo={p} offset={i % 2 === 1} />
    ))}
  </div>
</Base>
