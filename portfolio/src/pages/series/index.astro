---
import Base from '../../layouts/Base.astro';
import data from '../../data/site.json';
---
<Base title="Series" active="series">
  <h1 class="section-title">Series</h1>
  <div class="series-grid">
    {data.series.map((s) => {
      const cover = s.cover ?? s.photos.find((p) => p.src)?.src ?? null;
      return (
        <a class="series-card" href={`/series/${s.slug}/`}>
          <div class="cover">
            {cover && <img src={cover} alt={s.name} loading="lazy" />}
          </div>
          <div class="row">
            <span class="name">{s.name}</span>
            <span class="meta">{s.year} · {s.tag}</span>
          </div>
        </a>
      );
    })}
  </div>
</Base>
