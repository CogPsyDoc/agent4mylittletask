---
import Base from '../layouts/Base.astro';
import data from '../data/site.json';

const about = data.about;
---
<Base title="About" active="about">
  <div class="about">
    <div class="portrait">
      {about.photo && <img src={about.photo} alt={about.nameKo} />}
    </div>
    <div class="bio">
      <div class="name">{about.nameKo}<span class="en">{about.nameEn}</span></div>
      {about.paragraphs.map((p) => (
        <div class="para">{p}</div>
      ))}
      <div class="contacts">
        {about.contacts.map((c) => (
          <span>{c}</span>
        ))}
      </div>
    </div>
  </div>
</Base>
