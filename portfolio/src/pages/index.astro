---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import data from '../data/site.json';

// 연도별 그룹 (최신부터). 각 연도 안에서 시리즈 순서는 site.json의 순서를 따른다.
const years = [...new Set(data.series.map((s) => s.year))].sort().reverse();
const yearBlocks = years.map((year) => {
  const ss = data.series.filter((s) => s.year === year);
  const photos = ss.flatMap((s) =>
    s.photos.map((p) => ({ ...p, series: s.slug, seriesName: s.name }))
  );
  return {
    year,
    note: ss.map((s) => s.name).join(' · '),
    count: String(photos.length).padStart(2, '0') + ' WORKS',
    photos,
  };
});
---
<Base active="gallery">
  <div class="chips" id="chips">
    <button class="active" data-filter="all">ALL</button>
    {data.series.map((s) => (
      <button data-filter={s.slug}>{s.name}</button>
    ))}
  </div>

  {yearBlocks.map((y) => (
    <section class="year-block" data-year={y.year}>
      <div class="year-head">
        <span class="year">{y.year}</span>
        <span class="note">{y.note}</span>
        <span class="spacer"></span>
        <span class="count">{y.count}</span>
      </div>
      <div class="photo-grid">
        {y.photos.map((p, i) => (
          <Photo photo={p} offset={i % 2 === 1} series={p.series} seriesName={p.seriesName} />
        ))}
      </div>
    </section>
  ))}

  <script>
    // 필터 칩: 시리즈별로 사진·연도 섹션을 즉시 필터링 (애니메이션 없음 — 명세)
    const chips = document.querySelectorAll('#chips button');
    const blocks = document.querySelectorAll('section.year-block');

    function applyFilter(filter) {
      blocks.forEach((block) => {
        const figures = [...block.querySelectorAll('figure.photo')];
        const visible = figures.filter(
          (f) => filter === 'all' || f.dataset.series === filter
        );
        figures.forEach((f) => (f.hidden = !visible.includes(f)));
        // 오프셋 재계산: 보이는 사진 기준 홀수 인덱스만 내려앉음
        visible.forEach((f, i) => f.classList.toggle('offset', i % 2 === 1));
        // 연도 헤더 갱신
        const names = [...new Set(visible.map((f) => f.dataset.seriesName))];
        block.querySelector('.note').textContent = names.join(' · ');
        block.querySelector('.count').textContent =
          String(visible.length).padStart(2, '0') + ' WORKS';
        block.hidden = visible.length === 0;
      });
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.classList.toggle('active', c === chip));
        applyFilter(chip.dataset.filter);
      });
    });
  </script>
</Base>
