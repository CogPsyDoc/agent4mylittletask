---
import data from '../data/site.json';

interface Props {
  photo: { src: string | null; height: number; caption: string };
  offset?: boolean;
  series?: string;
  seriesName?: string;
}

const { photo, offset = false, series, seriesName } = Astro.props;
---
<figure
  class:list={['photo', { offset }]}
  data-series={series}
  data-series-name={seriesName}
>
  <div class="photo-frame" style={`height:${photo.height}px`}>
    {photo.src && <img src={photo.src} alt={photo.caption} loading="lazy" />}
  </div>
  {data.showCaptions && <figcaption>{photo.caption}</figcaption>}
</figure>
