---
import data from '../data/site.json';
import '../styles/global.css';

interface Props {
  title?: string;
  active: 'gallery' | 'series' | 'journal' | 'about';
}

const { title, active } = Astro.props;
const pageTitle = title ? `${title} — Chongwook Chung` : 'Chongwook Chung — Photo Archive';
const nav = [
  { key: 'gallery', label: 'GALLERY', href: '/' },
  { key: 'series', label: 'SERIES', href: '/series/' },
  { key: 'journal', label: 'JOURNAL', href: '/journal/' },
  { key: 'about', label: 'ABOUT', href: '/about/' },
];
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;800&family=Space+Mono&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
</head>
<body>
  <div class="page">
    {data.grain && <div class="grain"></div>}
    <header class="site">
      <a class="logo" href="/">{data.site.logo}<span class="tagline">{data.site.tagline}</span></a>
      <nav class="site">
        {nav.map((n) => (
          <a href={n.href} class={active === n.key ? 'active' : ''}>{n.label}</a>
        ))}
      </nav>
    </header>
    <main class="site">
      <slot />
    </main>
    <footer class="site">
      <span>{data.site.footerLeft}</span>
      <span>{data.site.footerRight}</span>
    </footer>
  </div>
</body>
</html>
