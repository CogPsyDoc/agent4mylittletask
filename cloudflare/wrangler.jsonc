// Cowork Sync Agent — Cloudflare Workers 설정
// 배포: npx wrangler deploy
// 시크릿: npx wrangler secret put ANTHROPIC_API_KEY
//        npx wrangler secret put SYNC_TOKEN
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cowork-sync-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],

  // 정적 UI (public/) — 에셋에 없는 경로(/agents/*)는 Worker로 넘어온다
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // 에이전트 = Durable Object (SQLite 내장)
  "durable_objects": {
    "bindings": [
      { "name": "CoworkAgent", "class_name": "CoworkAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CoworkAgent"] }
  ],

  "vars": {
    // 채팅에 사용할 모델 (시크릿 아님)
    "CLAUDE_MODEL": "claude-opus-4-8"
  },

  "observability": { "enabled": true }
}
