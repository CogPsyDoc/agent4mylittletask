# 로컬 개발용 시크릿 — 이 파일을 .dev.vars 로 복사해서 채우세요 (git에 올라가지 않음)
# 배포 환경에서는 `wrangler secret put <이름>` 으로 설정합니다.

# 이어서 대화하기(Claude 채팅)에 필요. 없어도 뷰어/동기화/리마인더는 동작.
ANTHROPIC_API_KEY=

# 설정하면 /sync 업로드에 Bearer 토큰 인증이 걸립니다 (강력 권장).
SYNC_TOKEN=

# 설정하면 뷰어(WebSocket/GET)도 토큰이 있어야 접근할 수 있습니다 (권장).
# 브라우저에서 처음 접속할 때 물어보고 localStorage에 저장됩니다.
VIEW_TOKEN=
